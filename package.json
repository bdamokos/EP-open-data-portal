{
  "name": "parliament-explorer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:api": "node --watch server/index.mjs",
    "build": "tsc -b && vite build",
    "check": "tsc -b --pretty false",
    "test": "node scripts/run-tests.mjs",
    "api:bump": "node scripts/api-version.mjs",
    "api:check": "node scripts/api-version.mjs --check",
    "data:audit": "node server/data-gap-audit-cli.mjs",
    "bench:amendments": "node scripts/amendment-benchmark.mjs",
    "bench:council-languages": "node scripts/amendment-council-language-benchmark.mjs",
    "bench:agenda": "node scripts/agenda-benchmark.mjs",
    "test:server": "node scripts/run-tests.mjs --server",
    "test:frontend": "node scripts/run-tests.mjs --frontend",
    "preview": "vite preview --host 127.0.0.1",
    "start": "node server/index.mjs",
    "test:fast": "node scripts/run-tests.mjs --fast",
    "test:slow": "node scripts/run-tests.mjs --slow"
  },
  "dependencies": {
    "@nodable/entities": "^3.1.0",
    "fast-xml-parser": "^5.11.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "happy-dom": "^21.0.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "license": "UNLICENSED",
  "engines": {
    "node": "^22.16.0 || >=24.0.0"
  }
}
