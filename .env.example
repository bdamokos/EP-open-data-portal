# Local adapter. Set HOST=0.0.0.0 only inside a controlled container/network.
HOST=127.0.0.1
PORT=8790
# Enable only behind a reverse proxy that overwrites forwarded headers.
TRUST_PROXY=false
EXPLORER_SERVE_STATIC=true
# Boolean settings accept 1/true/yes/on or 0/false/no/off (case-insensitive).
# Maximum JSON response size, in bytes (65536–26214400).
# JSON_RESPONSE_LIMIT_BYTES=5242880
# Extracted document text cache disk budget, in MiB (16–8192).
# DOCUMENT_TEXT_MAX_DISK_MIB=256
# Optional full source commit SHA for release verification.
# APP_REVISION=
# EXPLORER_DIST_DIR=./dist
# Public-source cache and joined activity index stay outside Git.
# ODP_CACHE_DIR=./var/cache
# ACTIVITY_INDEX_DIR=./var/index
# Local activity history requires a bounded background indexer.
# Leave disabled for frontend-only/offline development.
ACTIVITY_INDEX_ENABLED=false
# ACTIVITY_INDEX_JOB_REQUEST_BUDGET=1000
# ACTIVITY_INDEX_JOB_MAX_MINUTES=90
# ACTIVITY_INDEX_MAX_DISK_MIB=8192
# Full-text corpus of speeches, questions and answers (separate SQLite file).
# Joins the activity index read-only; one writer per corpus directory.
CORPUS_ENABLED=false
# CORPUS_DIR=./var/corpus
# all = every supplied language (most speech languages are machine translations);
# primary = originals and English only.
# CORPUS_LANGUAGES=all
# CORPUS_MAX_DISK_MIB=2048
# CORPUS_JOB_REQUEST_BUDGET=300
# Optional extra local worker pacing; API quota is enforced by shared admission.
# CORPUS_REQUEST_INTERVAL_MS=0
